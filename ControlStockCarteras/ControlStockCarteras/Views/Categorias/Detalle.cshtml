@model ControlStockCarteras.Datos.Modelos.Categoria

@{
    ViewData["Title"] = "Detalle de categoría";
}

<h1>Detalle de categoría</h1>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>
</dl>

@if (User.IsInRole("Administrador"))
{
    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
}
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>

