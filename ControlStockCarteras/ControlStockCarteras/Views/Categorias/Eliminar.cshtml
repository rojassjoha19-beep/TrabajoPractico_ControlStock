@model ControlStockCarteras.Datos.Modelos.Categoria

@{
    ViewData["Title"] = "Dar de baja categoría";
}

<h1>Dar de baja categoría</h1>

<p>¿Seguro que querés dar de baja la categoría <strong>@Model.Nombre</strong>?</p>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Dar de baja</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>