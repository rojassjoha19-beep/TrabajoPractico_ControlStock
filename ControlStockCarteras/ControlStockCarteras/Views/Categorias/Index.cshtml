@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td>
                    <a asp-action="Detalle" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Dar de baja</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>