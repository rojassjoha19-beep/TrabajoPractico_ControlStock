@model IEnumerable<ControlStockCarteras.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

<a asp-action="Crear" class="btn btn-primary mb-3">Nueva categoría</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
            </tr>
        }
    </tbody>
</table>
